VERSION=0.7
SITELISP=/usr/share/emacs/site-lisp
TMPFILE="$(mktemp /tmp/emacs-updater.XXXXXX)"
PKGFILE="$(mktemp /tmp/emacs-updater.XXXXXX)"
ACTIONS=
PM_COMMAND=pm_portage

cat <<-EOF

Emacs updater version ${VERSION}
Written by the Gentoo Emacs team http://www.gentoo.org/proj/en/lisp/emacs/
Find packages that are installed in the wrong location or rebuild all
GNU Emacs packages

EOF

usage() {
    sed -e 's/^X//' <<-EOF
	Usage: ${0##*/} [OPTION]...
	X  -a, --action <arg>     arg is one out of
	X                         'obsolete_location': find site-files not
	X                           in the new-style location
	X                         'rebuild': rebuild packages with Elisp files
	X                           byte-compiled by a different Emacs version
	X                         'rebuild_all': rebuild all packages that have
	X                           byte-compiled Elisp files
	X  -n, --nocolour         disable colour in output
	X  -p, --pretend          don't actually emerge packages
	X  -P, --package-manager <arg>
	X                         Select a package manager. arg is one out of
	X                         'portage' (default), 'pkgcore', or 'paludis'
	X  -h, --help             display this help and exit
	EOF
    exit ${1}
}

# Read in all command-line options and force English output
OPTIONS=$(LC_ALL=C getopt -o a:hnpP: \
    --long action:,help:,nocolour,pretend,package-manager \
    -n 'emacs-updater' -- "$@")
[ $? -eq 0 ] || usage 1

eval set -- "${OPTIONS}"

while true
do
    case "${1}" in
	-h|--help)      usage 0 ;;
	-p|--pretend)   PRETEND="true"; shift 1 ;;
	-n|--nocolour)  NOCOLOUR="true"; shift 1 ;;
	-a|--action)
	    case "${2}" in
		obsolete_location | rebuild | rebuild_all)
		    ACTIONS="${ACTIONS} ${2}"
		    ;;
		*)
		    echo "Invalid action given!"
		    exit 20
		    ;;
	    esac
	    shift 2
	    ;;
	-P|--package-manager)
	    case "${2}" in
		portage|pkgcore|paludis)
		    PM_COMMAND=pm_${2}
		    ;;
		*)
		    echo "Package manager ${2} not known!"
		    exit 21
		    ;;
	    esac
	    shift 2
	    ;;

	--) shift; break ;;
    esac
done

# Default action if the user did not specify it
ACTIONS=${ACTIONS:-obsolete_location}

# Only set colours if output is not redirected or the --no-colour
# option is not set
if [ -t 1 ] && [ -z "${NOCOLOUR}" ] ; then
    RED=$(tput -S <<<$'setaf 1\nbold')
    GREEN=$(tput -S <<<$'setaf 2\nbold')
    YELLOW=$(tput -S <<<$'setaf 3\nbold')
    BLUE=$(tput -S <<<$'setaf 4\nbold')
    MAGENTA=$(tput -S <<<$'setaf 5\nbold')
    CYAN=$(tput -S <<<$'setaf 6\nbold')
    BOLD=$(tput bold)
    NORMAL=$(tput sgr0)
fi

# Some type of output can be prettified and capsulated in functions
message() {
    local OUTPUT=$@
    echo "${GREEN}*${NORMAL}${BOLD} ${OUTPUT}${NORMAL}"
}

warning() {
    local OUTPUT=$@
    echo "${YELLOW}*${NORMAL}${BOLD} ${OUTPUT}${NORMAL}"
}

failure() {
    local OUTPUT=$@
    echo "${RED}*${NORMAL}${BOLD} ${OUTPUT}${NORMAL}"
}

if ! [ -x /usr/bin/emacs ]; then
    echo
    failure "Please emerge virtual/emacs to use this tool"
    exit 2
fi

if ! [ -x /usr/bin/qfile ]; then
    echo
    failure "Please emerge app-portage/portage-utils to use this tool"
    exit 2
fi

emacs-version() {
    /usr/bin/emacs -batch -q --no-site-file --eval "(princ emacs-version)" \
	|| { failure "Cannot run Emacs"; exit 5; }
}

obsolete_location() {
    local sf

    message "Searching for site-init files in obsolete location ..."

    # Set nullglob option since there may be no matching files
    local old_shopts=$(shopt -p nullglob)
    shopt -s nullglob

    for sf in "${ROOT}${SITELISP}"/[0-9][0-9]*-gentoo.el
    do
	[ "${sf##*/}" = 00site-gentoo.el ] && continue
	echo "Found ${sf##*/}"
	echo "${sf}" >> "${TMPFILE}"
    done

    eval "${old_shopts}"
    echo
}

rebuild() {
    local active version elc

    message "Searching for byte-compiled elisp files ..."
    active=$(emacs-version)
    [ -n "${active}" ] || { failure "Cannot determine Emacs version"; exit 6; }
    message "Currently selected GNU Emacs version: ${active}"

    for elc in $(find ${SITELISP} -name "*.elc")
    do
	version=$(sed -n \
	    '/^[^;]/q;s/\.$//;s/.*emacs version \([0-9].*\)/\1/Ip' ${elc})
	version=${version:-unknown}

	if [ "${version}" != "${active}" ] || [ "${1}" = all ]; then
	    echo "Found ${elc##*/} (compiled by Emacs version ${version})"
	    echo "${elc}" >> "${TMPFILE}"
	else
	    echo "Skipping ${elc##*/} (compiled by Emacs version ${version})"
	fi
    done
    echo
}

rebuild_all() {
    rebuild all
}

# Wrapper for package manager commands
pm_portage() {
    emerge --oneshot --ask --verbose "$@"
}

pm_pkgcore() {
    pmerge --oneshot --ask "$@"
}

pm_paludis() {
    paludis --install --preserve-world "$@"
}

cleanup() {
    rm -f "${TMPFILE}" "${PKGFILE}"
}

trap cleanup EXIT

for action in ${ACTIONS}; do
    ${action}
done

if [ ! -s "${TMPFILE}" ]; then
    warning "No files to update, quitting."
    exit 3
fi

message "Assigning files to packages ..."
qfile -qCR -f "${TMPFILE}" | sort -u > "${PKGFILE}"

if [ ! -s "${PKGFILE}" ]; then
    warning "No packages to update, quitting."
    exit 3
fi

NO_OF_PACKAGES=$(sed -n '$=' "${PKGFILE}")

[ ${NO_OF_PACKAGES} -eq 1 ] && s= || s=s
message "${NO_OF_PACKAGES} package${s} to remerge:"

cat "${PKGFILE}"

if [ "${PRETEND}" ]; then
    exit 4
fi

echo
echo -n "${BOLD}Remerge packages?${NORMAL} [${GREEN}Yes${NORMAL}/${RED}No${NORMAL}] "
read choice
echo
case "${choice}" in
    y*|Y*|"")
	;;
    *)
	warning "Quitting."
	exit 10 ;;
esac

${PM_COMMAND} $(cat "${PKGFILE}")

warning "If a package is being rebuilt over and over again,"
warning "please report it on http://bugs.gentoo.org/"
